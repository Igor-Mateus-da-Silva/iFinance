# ==============================================================================
# iFinance Capital - Git Ignore & Security Rules
# ==============================================================================

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node dependencies
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Sensitive Environment files & Credentials (NUNCA COMMITAR)
/src/environments/environment.ts
/src/environments/environment.development.ts
/src/environments/*.local.ts
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Hosting & Cloud CLI (Vercel)
.vercel

# Supabase CLI local cache & branches
/supabase/.temp/
/supabase/.branches/

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/*

# Visual Studio Code (Manter apenas configs de time, ignorar estados e credenciais de usuário)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# Angular & Build cache
/.angular/cache
.sass-cache/
/connect.lock
/typings
__screenshots__/

# Testing & Coverage
/coverage
/.vitest
testem.log
*.lcov

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
